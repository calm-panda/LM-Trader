# ── Upstox API (required) ─────────────────────────────────────────────────────
UPSTOX_API_KEY=your-upstox-api-key
UPSTOX_API_SECRET=your-upstox-api-secret
UPSTOX_REDIRECT_URI=https://mypi.tail9906f3.ts.net:8000/auth/callback

# ── Upstox auto-login (optional but strongly recommended) ─────────────────────
# Enables headless TOTP re-login at 08:30 IST every trading day so the
# access token is refreshed before market open without manual intervention.
#
# How to get UPSTOX_TOTP_SECRET:
#   1. Log in to Upstox web → Profile → 2FA settings → "Show QR code"
#   2. Click "Can't scan QR?" to see the base32 secret string
#   3. Paste it here (no spaces).  It looks like: JBSWY3DPEHPK3PXPJBSWY3DP
#
UPSTOX_MOBILE=9876543210       # 10-digit registered mobile
UPSTOX_PIN=123456              # 6-digit Upstox trading PIN
UPSTOX_TOTP_SECRET=            # base32 TOTP secret from Upstox 2FA setup

# ── DeepSeek AI (required for AI features) ────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-key

# ── NewsAPI (optional — enables live headlines for sentiment analysis) ─────────
NEWSAPI_KEY=

# ── App settings ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/trading.db
PAPER_STARTING_CAPITAL=100000
LIVE_TRADING_ENABLED=false
SECRET_KEY=change-me-to-a-random-32-char-string

# ── Risk limits ────────────────────────────────────────────────────────────────
MAX_CAPITAL_PER_TRADE_PCT=10    # % of portfolio per trade
MAX_OPEN_POSITIONS=5
DAILY_LOSS_LIMIT_PCT=2          # pause all trading if down 2% on the day

# ── Watchlist ──────────────────────────────────────────────────────────────────
# Comma-separated NSE symbols to bootstrap OHLCV history for and stream live
WATCHLIST=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK,SBIN,WIPRO,AXISBANK,KOTAKBANK,LT

# ── AI signal confirmation gate ───────────────────────────────────────────────
SIGNAL_VALIDITY_MINUTES=15
SIGNAL_GENERATION_INTERVAL_MINUTES=5
SIGNAL_CONFIDENCE_THRESHOLD=0.55
